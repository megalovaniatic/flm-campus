# ─────────────────────────────────────────────────────────────────────────────
# FLM Campus · API — variables de entorno
# Copia este archivo como `.env` en apps/api (desarrollo) o define las variables en
# el servicio (Docker, Render, Fly.io). Nunca subas el `.env` real al repositorio.
# ─────────────────────────────────────────────────────────────────────────────

# development | production | test
NODE_ENV=development

# Puerto HTTP de la API (detrás de Caddy u otro proxy en producción).
PORT=3000
# Interfaz de escucha. Por defecto 127.0.0.1 en desarrollo y 0.0.0.0 en producción.
# HOST=0.0.0.0

# Origen público de la web, sin ruta final. Se usa para comprobar la cabecera Origin (CSRF)
# y para construir los enlaces de activación y recuperación de los correos.
# En producción es obligatorio y debe ser https://
APP_ORIGIN=http://localhost:5173

# Base de datos SQLite (se crea si no existe). En Docker: /app/data/campus.sqlite
DATABASE_PATH=./data/campus.sqlite

# Carpeta privada de archivos subidos (PDF e imágenes). Nunca debe servirse como estática.
# En Docker: /app/storage
STORAGE_DIR=./storage

# Carpeta de destino de `npm run backup`. En Docker: /app/backups
BACKUP_DIR=./backups

# Correo saliente (SMTP). Si SMTP_HOST está vacío no se envían correos: en desarrollo se
# muestran en la consola y en producción el enlace de activación se devuelve a administración.
SMTP_HOST=
SMTP_PORT=587
# true para TLS directo (puerto 465); con 587 se exige STARTTLS.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=FLM Campus <campus@flmexperts.com>

# Proxies de confianza delante de la API para leer la IP real de X-Forwarded-For
# (límites de frecuencia y auditoría): false, true (= 1 proxy, p. ej. Caddy) o un número.
TRUST_PROXY=false

# Servir la web compilada desde el mismo origen: false, true (= ../web/dist) o una ruta.
SERVE_WEB_DIST=false
