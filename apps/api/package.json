{
  "name": "@flm/api",
  "version": "1.0.0",
  "private": true,
  "description": "API de producción de FLM Campus: Hono, SQLite (node:sqlite) y reglas compartidas con la web.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "build": "node scripts/build.mjs",
    "start": "node --disable-warning=ExperimentalWarning dist/server.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "seed": "tsx src/cli/seed.ts",
    "create-admin": "tsx src/cli/create-admin.ts",
    "backup": "tsx src/cli/backup.ts"
  },
  "dependencies": {
    "@flm/shared": "*",
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.14",
    "nodemailer": "^10.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
